 <Number Name="GeometryCompileTime" Description="Geometry shader compile time" Tag="Time" Unit="ms">36.224998</Number>
 <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">44.693001</Number>
 <Text>glGetAttribLocation(1, a_position);</Text>
 <Text>// 0 returned</Text>
 <Text>glGetAttribLocation(1, a_color);</Text>
 <Text>// 1 returned</Text>
 <Text>glGenVertexArrays(1, 0x0a96e65c);</Text>
 <Text>// arrays = { 1 }</Text>
 <Text>glBindVertexArray(1);</Text>
 <Text>glGenBuffers(1, 0x0a96e660);</Text>
 <Text>// buffers = { 1 }</Text>
