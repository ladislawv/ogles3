 <Text>glGenBuffers(1, 0x0a96e664);</Text>
 <Text>// buffers = { 2 }</Text>
 <Text>glBindBuffer(GL_ARRAY_BUFFER, 2);</Text>
 <Text>glBufferData(GL_ARRAY_BUFFER, 32, 0xadb3f24, GL_STATIC_DRAW);</Text>
 <Text>glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, 0, 0);</Text>
 <Text>glEnableVertexAttribArray(1);</Text>
 <Text>glClearColor(0, 0, 0, 1);</Text>
