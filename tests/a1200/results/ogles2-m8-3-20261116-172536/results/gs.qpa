 <Number Name="FragmentCompileTime" Description="Fragment shader compile time" Tag="Time" Unit="ms">0.744000</Number>
 <Number Name="GeometryCompileTime" Description="Geometry shader compile time" Tag="Time" Unit="ms">29.909000</Number>
 <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">44.208000</Number>
 <Text>glGetAttribLocation(1, a_position);</Text>
 <Text>// 0 returned</Text>
 <Text>glGetAttribLocation(1, a_emitCount);</Text>
 <Text>// 1 returned</Text>
 <Text>glGenVertexArrays(1, 0x0a96e65c);</Text>
 <Text>// arrays = { 1 }</Text>
 <Text>glBindVertexArray(1);</Text>
 <Text>glGenBuffers(1, 0x0a96e660);</Text>
 <Text>// buffers = { 1 }</Text>
 <Text>glBindBuffer(GL_ARRAY_BUFFER, 1);</Text>
 <Text>glBufferData(GL_ARRAY_BUFFER, 16, 0xad7353c, GL_STATIC_DRAW);</Text>
 <Text>glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, 0, 0);</Text>
 <Text>glEnableVertexAttribArray(0);</Text>
 <Text>glGenBuffers(1, 0x0a96e664);</Text>
 <Text>// buffers = { 2 }</Text>
 <Text>glBindBuffer(GL_ARRAY_BUFFER, 2);</Text>
 <Text>glBufferData(GL_ARRAY_BUFFER, 16, 0xad73554, GL_STATIC_DRAW);</Text>
 <Text>glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, 0, 0);</Text>
 <Text>glEnableVertexAttribArray(1);</Text>
 <Text>glClearColor(0, 0, 0, 1);</Text>
 <Text>glClear(GL_COLOR_BUFFER_BIT);</Text>
 <Text>glViewport(0, 0, 256, 256);</Text>
