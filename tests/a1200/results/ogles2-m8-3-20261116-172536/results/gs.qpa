<TestCaseResult CasePath="dEQP-GLES31.functional.geometry_shading.instanced.invocation_output_vary_by_attribute" Version="0.3.4" CaseType="SelfValidate">
 <Text>GL_MAX_GEOMETRY_OUTPUT_VERTICES = 256</Text>
 <Text>GL_MAX_GEOMETRY_TOTAL_OUTPUT_COMPONENTS = 1024</Text>
