 <Number Name="FragmentCompileTime" Description="Fragment shader compile time" Tag="Time" Unit="ms">1.087000</Number>
 <Number Name="GeometryCompileTime" Description="Geometry shader compile time" Tag="Time" Unit="ms">2.157000</Number>
 <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">33.778000</Number>
 <Text>glGetAttribLocation(1, a_position);</Text>
 <Text>// 0 returned</Text>
 <Text>glGetAttribLocation(1, a_color);</Text>
 <Text>// 1 returned</Text>
 <Text>glGenVertexArrays(1, 0x0a96e65c);</Text>
 <Text>// arrays = { 1 }</Text>
 <Text>glBindVertexArray(1);</Text>
 <Text>glGenBuffers(1, 0x0a96e660);</Text>
 <Text>// buffers = { 1 }</Text>
