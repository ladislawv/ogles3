 <Text>// GL_NO_ERROR returned</Text>
 <Text>glUseProgram(0);</Text>
 <Text>glDisableVertexAttribArray(0);</Text>
 <Text>glDisableVertexAttribArray(1);</Text>
 <Text>glDeleteBuffers(1, { 1 });</Text>
 <Text>glDeleteBuffers(1, { 2 });</Text>
 <Text>glDeleteVertexArrays(1, { 1 });</Text>
