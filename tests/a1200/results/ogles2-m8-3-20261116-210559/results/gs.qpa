 <Number Name="GeometryCompileTime" Description="Geometry shader compile time" Tag="Time" Unit="ms">26.891001</Number>
 <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">36.556000</Number>
 <Text>glGetAttribLocation(1, a_position);</Text>
 <Text>// 0 returned</Text>
 <Text>glGetAttribLocation(1, a_emitCount);</Text>
 <Text>// 1 returned</Text>
 <Text>glGenVertexArrays(1, 0x0a96e65c);</Text>
 <Text>// arrays = { 1 }</Text>
 <Text>glBindVertexArray(1);</Text>
 <Text>glGenBuffers(1, 0x0a96e660);</Text>
 <Text>// buffers = { 1 }</Text>
