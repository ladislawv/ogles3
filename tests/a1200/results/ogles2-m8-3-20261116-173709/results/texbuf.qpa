#beginTestCaseResult dEQP-GLES31.functional.texture.texture_buffer.state_query.texture_buffer_data_store_binding_integer
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.texture.texture_buffer.state_query.texture_buffer_data_store_binding_integer" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="NonBuffer" Description="Non-buffer">
  <Text>glGenTextures(1, 0x0a96e63e);</Text>
  <Text>// textures = { 1 }</Text>
  <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
  <Text>glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 32, 32);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_BUFFER_DATA_STORE_BINDING, 0x0a96e59c);</Text>
  <Text>// params = { -555819298 }</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
  <Text> // ERROR: glGetTexLevelParameteriv: glGetError() returned GL_INVALID_ENUM</Text>
  <Text>glDeleteTextures(1, { 1 });</Text>
</Section>
 <Section Name="Buffer" Description="Texture buffer">
  <Text>glGenTextures(1, 0x0a96e63a);</Text>
  <Text>// textures = { 1 }</Text>
  <Text>glBindTexture(GL_TEXTURE_BUFFER, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGenBuffers(1, 0x0a96e63e);</Text>
  <Text>// buffers = { 1 }</Text>
  <Text>glBindBuffer(GL_TEXTURE_BUFFER, 1);</Text>
  <Text>glBufferData(GL_TEXTURE_BUFFER, 32, 0, GL_STATIC_DRAW);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glTexBuffer(GL_TEXTURE_BUFFER, GL_R32UI, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetTexLevelParameteriv(GL_TEXTURE_BUFFER, 0, GL_TEXTURE_BUFFER_DATA_STORE_BINDING, 0x0a96e59c);</Text>
  <Text>// params = { 1 }</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glDeleteTextures(1, { 1 });</Text>
  <Text>glDeleteBuffers(1, { 1 });</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">12707</Number>
