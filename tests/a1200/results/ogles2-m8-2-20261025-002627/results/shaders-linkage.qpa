  <InfoLog></InfoLog>
  <VertexShader CompileStatus="OK">
   <ShaderSource></ShaderSource>
   <InfoLog></InfoLog>
</VertexShader>
  <FragmentShader CompileStatus="Fail">
   <ShaderSource>#version 300 es
layout(location = 0) out mediump vec4 dEQP_FragColor;

in mediump int var;
void main()
{
    dEQP_FragColor = vec4(1.0);
}
</ShaderSource>
   <InfoLog>0:4(1): error: if a fragment input is (or contains) an integer, then it must be qualified with &apos;flat&apos;
</InfoLog>
</FragmentShader>
