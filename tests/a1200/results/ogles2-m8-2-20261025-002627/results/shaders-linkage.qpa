#beginTestCaseResult dEQP-GLES3.functional.shaders.linkage.varying.rules.invalid_type_uint
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES3.functional.shaders.linkage.varying.rules.invalid_type_uint" Version="0.3.4" CaseType="SelfValidate">
 <Text>Expecting shader compilation to fail.</Text>
 <ShaderProgram LinkStatus="Fail">
  <InfoLog></InfoLog>
  <VertexShader CompileStatus="OK">
   <ShaderSource></ShaderSource>
   <InfoLog></InfoLog>
</VertexShader>
  <FragmentShader CompileStatus="Fail">
   <ShaderSource>#version 300 es
layout(location = 0) out mediump vec4 dEQP_FragColor;

in mediump uint var;
