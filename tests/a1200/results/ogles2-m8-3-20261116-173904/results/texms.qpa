#beginTestCaseResult dEQP-GLES31.functional.texture.multisample.negative.texture_wrap_s
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.texture.multisample.negative.texture_wrap_s" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="Iteration" Description="Testing parameter with color texture">
  <Text>glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, 1);</Text>
  <Text>glTexStorage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 1, GL_RGBA8, 16, 16, GL_FALSE);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glTexParameteri(GL_TEXTURE_2D_MULTISAMPLE, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
