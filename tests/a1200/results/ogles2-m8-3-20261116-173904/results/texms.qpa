#beginTestCaseResult dEQP-GLES31.functional.texture.multisample.negative.fbo_attach_different_fixed_state_tex_tex
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES31.functional.texture.multisample.negative.fbo_attach_different_fixed_state_tex_tex" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenFramebuffers(1, 0x0a98e638);</Text>
 <Text>// framebuffers = { 1 }</Text>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 1);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGenTextures(1, 0x0a98e640);</Text>
 <Text>// textures = { 1 }</Text>
 <Text>glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, 1);</Text>
 <Text>glTexStorage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 4, GL_RGBA8, 64, 64, GL_FALSE);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGetTexLevelParameteriv(GL_TEXTURE_2D_MULTISAMPLE, 0, GL_TEXTURE_SAMPLES, 0x0a98e648);</Text>
 <Text>// params = { 4 }</Text>
 <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D_MULTISAMPLE, 1, 0);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGenTextures(1, 0x0a98e644);</Text>
 <Text>// textures = { 2 }</Text>
 <Text>glBindTexture(GL_TEXTURE_2D_MULTISAMPLE, 2);</Text>
 <Text>glTexStorage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 4, GL_RGBA8, 64, 64, GL_TRUE);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGetTexLevelParameteriv(GL_TEXTURE_2D_MULTISAMPLE, 0, GL_TEXTURE_SAMPLES, 0x0a98e64c);</Text>
 <Text>// params = { 4 }</Text>
 <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D_MULTISAMPLE, 2, 0);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glCheckFramebufferStatus(GL_FRAMEBUFFER);</Text>
 <Text>// GL_FRAMEBUFFER_INCOMPLETE_MULTISAMPLE returned</Text>
 <Text>glDeleteFramebuffers(1, { 1 });</Text>
 <Text>glDeleteRenderbuffers(1, { 0 });</Text>
 <Text>glDeleteTextures(1, { 1 });</Text>
 <Text>glDeleteTextures(1, { 2 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">14201</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult

