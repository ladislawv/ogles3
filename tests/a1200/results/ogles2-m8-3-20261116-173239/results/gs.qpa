 <Text>glBufferData(GL_ARRAY_BUFFER, 32, 0xadb366c, GL_STATIC_DRAW);</Text>
 <Text>glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, 0, 0);</Text>
 <Text>glEnableVertexAttribArray(1);</Text>
