  <Text>glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 1);</Text>
  <Text>glFramebufferTexture(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, 1, 0);</Text>
