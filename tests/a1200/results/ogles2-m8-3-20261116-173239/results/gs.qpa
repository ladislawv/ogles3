 <Number Name="GeometryCompileTime" Description="Geometry shader compile time" Tag="Time" Unit="ms">2.082000</Number>
 <Number Name="LinkTime" Description="Link time" Tag="Time" Unit="ms">5.967000</Number>
 <Text>glGetAttribLocation(1, a_position);</Text>
 <Text>// 0 returned</Text>
 <Text>glGetAttribLocation(1, a_emitCount);</Text>
 <Text>// 1 returned</Text>
