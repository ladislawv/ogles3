<TestCaseResult CasePath="dEQP-GLES3.functional.buffer.write.basic.copy_write_static_copy" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenBuffers(1, 0x098110f8);</Text>
 <Text>// buffers = { 3 }</Text>
 <Text>glBindBuffer(GL_COPY_WRITE_BUFFER, 3);</Text>
 <Text>glBufferData(GL_COPY_WRITE_BUFFER, 1020, 0x982f41c, GL_STATIC_COPY);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);</Text>
 <Text>glViewport(0, 0, 256, 256);</Text>
 <Text>glClearColor(0, 0, 0, 1);</Text>
 <Text>glUseProgram(1);</Text>
 <Text>glBindVertexArray(1);</Text>
 <Text>glBindBuffer(GL_ARRAY_BUFFER, 1);</Text>
 <Text>glBufferData(GL_ARRAY_BUFFER, 32768, 0x98da2bc, GL_STATIC_DRAW);</Text>
 <Text>glEnableVertexAttribArray(0);</Text>
 <Text>glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);</Text>
 <Text>glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 2);</Text>
 <Text>glBufferData(GL_ELEMENT_ARRAY_BUFFER, 12288, 0x8fb5854, GL_STATIC_DRAW);</Text>
 <Text>glEnableVertexAttribArray(1);</Text>
 <Text>glBindBuffer(GL_ARRAY_BUFFER, 3);</Text>
 <Text>glClear(GL_COLOR_BUFFER_BIT);</Text>
 <Text>glVertexAttribPointer(1, 3, GL_UNSIGNED_BYTE, GL_TRUE, 0, 0);</Text>
 <Text>glDrawElements(GL_TRIANGLES, 510, GL_UNSIGNED_SHORT, 0);</Text>
 <ImageSet Name="RenderResult" Description="Bytes 0 to 1019" />
 <Text>glBindVertexArray(0);</Text>
 <Text>glDeleteBuffers(1, { 3 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">24307</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult

