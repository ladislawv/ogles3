; Run-M1 - ogles2 M8 run 5: OpenGL ES 3.1 contexts (stage D).
;   See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   After a reboot in the middle:  Execute Run-M1 FROM=<step>
; Nothing is installed: libs/ is added to LIBS: for the run and removed at
; the end; OGLES2Cache: points at cache/. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m8-5 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M8R5: ""
If NOT EXISTS M8R5:results
  MakeDir M8R5:results
EndIf
If EXISTS M8R5:cache
  Delete M8R5:cache ALL QUIET >NIL:
EndIf
MakeDir M8R5:cache
Assign OGLES2Cache: M8R5:cache
Echo "ogles2 M8 run 5, starting at step {FROM}" >>M8R5:results/00-progress.txt
Date >>M8R5:results/00-progress.txt
; An ogles2 installed in LIBS: would win over the package's (added after it).
List LIBS:ogles2#? LIBS:v3dglslc >M8R5:results/00-libs.txt
SetEnv OGLES2/LogFile M8R5:results/ogles2.log
; m8_draw reads its shaders from shaders/ here.
CD M8R5:bin
Assign LIBS: M8R5:libs ADD
Avail FLUSH >NIL:

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 3: OpenGL ES 3.1's state, a few seconds."
  M8R5:bin/m8_es31 ES31 >M8R5:results/1-m8_es31.txt
  Echo "step 1 done" >>M8R5:results/00-progress.txt
EndIf
If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 3: the ES 3.1 limits, a second."
  M8R5:bin/m8_es31 LIMITS >M8R5:results/2-limits.txt
  Echo "step 2 done" >>M8R5:results/00-progress.txt
EndIf
If NOT {FROM} GT 3 VAL
  Echo "Step 3 of 3: OpenGL ES 3 programs drawn into a hidden bitmap in an"
  Echo "  OpenGL ES 3.1 context, a few seconds."
  M8R5:bin/m8_draw >M8R5:results/3-m8_draw.txt
  Echo "step 3 done" >>M8R5:results/00-progress.txt
EndIf

Avail FLUSH >NIL:
Assign LIBS: M8R5:libs REMOVE
CD M8R5:
UnSetEnv OGLES2/LogFile
Assign OGLES2Cache:
If NOT EXISTS M8R5:results/notes.txt
  Copy M8R5:notes-template.txt M8R5:results/notes.txt
EndIf
List M8R5:results >M8R5:results/99-files.txt
Echo "finished" >>M8R5:results/00-progress.txt
Date >>M8R5:results/00-progress.txt
Assign M8R5:
Echo ""
Echo "Done. Results are in results/."
