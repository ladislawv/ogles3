; Run-M1 - ogles2 M8 run 7: the render chain (a framebuffer object's job
;   queued behind the running render). See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
; Nothing is installed: libs/ is added to LIBS: for the run and removed at
; the end; OGLES3Cache: points at cache/. Output goes to results/.
.key FROM/K,FRAMES/K
.def FROM 1
.def FRAMES 60
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles3.library
  Echo "Please CD into the ogles2-m8-7 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M8R7: ""
If NOT EXISTS M8R7:results
  MakeDir M8R7:results
EndIf
If EXISTS M8R7:cache
  Delete M8R7:cache ALL QUIET >NIL:
EndIf
MakeDir M8R7:cache
Assign OGLES3Cache: M8R7:cache
Echo "ogles2 M8 run 7, starting at step {FROM}" >>M8R7:results/00-progress.txt
Date >>M8R7:results/00-progress.txt
; An ogles3 installed in LIBS: would win over the package's (added after it).
List LIBS:ogles3#? LIBS:v3dglslc3 >M8R7:results/00-libs.txt
CD M8R7:bin
Assign LIBS: M8R7:libs ADD
Avail FLUSH >NIL:
UnSetEnv OGLES3/NoQueue

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 2: the chain, a 640x480 screen changing colour, about"
  Echo "  four seconds."
  SetEnv OGLES3/LogFile M8R7:results/1-chain.log
  M8R7:bin/m8_queue {FRAMES} >M8R7:results/1-chain.txt
  Echo "step 1 done" >>M8R7:results/00-progress.txt
EndIf
If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 2: the same without the chain (ENV:OGLES3/NoQueue),"
  Echo "  the control."
  SetEnv OGLES3/NoQueue 1
  SetEnv OGLES3/LogFile M8R7:results/2-noqueue.log
  M8R7:bin/m8_queue {FRAMES} >M8R7:results/2-noqueue.txt
  UnSetEnv OGLES3/NoQueue
  Echo "step 2 done" >>M8R7:results/00-progress.txt
EndIf

Avail FLUSH >NIL:
Assign LIBS: M8R7:libs REMOVE
CD M8R7:
UnSetEnv OGLES3/LogFile
Assign OGLES3Cache:
If NOT EXISTS M8R7:results/notes.txt
  Copy M8R7:notes-template.txt M8R7:results/notes.txt
EndIf
List M8R7:results >M8R7:results/99-files.txt
Echo "finished" >>M8R7:results/00-progress.txt
Date >>M8R7:results/00-progress.txt
Assign M8R7:
Echo ""
Echo "Done. Results are in results/."
