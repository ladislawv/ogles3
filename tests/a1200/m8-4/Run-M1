; Run-M1 - ogles2 M8 run 4: OpenGL ES 3 contexts through SDL2 and SDL3.
;   See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   After a reboot in the middle:  Execute Run-M1 FROM=<step>
; Nothing is installed: libs-es3/, then libs-release/ are added to LIBS: for
; their steps and removed after them. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs-es3/ogles3.library
  Echo "Please CD into the ogles2-m8-4 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M8R4: ""
If NOT EXISTS M8R4:results
  MakeDir M8R4:results
EndIf
If NOT EXISTS M8R4:cache
  MakeDir M8R4:cache
EndIf
Assign OGLES3Cache: M8R4:cache
Echo "ogles2 M8 run 4, starting at step {FROM}" >>M8R4:results/00-progress.txt
Date >>M8R4:results/00-progress.txt
; An ogles2 installed in LIBS: would win over the package's (added after it).
List LIBS:ogles3#? LIBS:v3dglslc3 >M8R4:results/00-libs.txt
SetEnv OGLES3/LogFile M8R4:results/ogles2.log
CD M8R4:bin

; The ES3=1 test build: ES 3.0 contexts.
Assign LIBS: M8R4:libs-es3 ADD
Avail FLUSH >NIL:
If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 5: SDL2 asks for OpenGL ES 3.0, 3.2 and 2.0 in a small"
  Echo "  window (a green triangle on red for a moment), a few seconds."
  M8R4:bin/gles3test >M8R4:results/1-sdl2-gles3test.txt
  Echo "step 1 done" >>M8R4:results/00-progress.txt
EndIf
If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 5: the same with SDL3, a few seconds."
  M8R4:bin3/gles3test >M8R4:results/2-sdl3-gles3test.txt
  Echo "step 2 done" >>M8R4:results/00-progress.txt
EndIf
If NOT {FROM} GT 3 VAL
  Echo "Step 3 of 5: SDL2 testgles2 in a window, 4 seconds: a spinning cube."
  M8R4:bin/testgles2 --seconds 4 >M8R4:results/3-testgles2.txt
  Echo "step 3 done" >>M8R4:results/00-progress.txt
EndIf
Avail FLUSH >NIL:
Assign LIBS: M8R4:libs-es3 REMOVE

; A release build (ogles3.library 1.0): ES 3.0 asked gives ES 3.1.
Assign LIBS: M8R4:libs-release ADD
Avail FLUSH >NIL:
If NOT {FROM} GT 4 VAL
  Echo "Step 4 of 5: SDL2 asks a release build for OpenGL ES 3.0 (3.1 given), a second."
  M8R4:bin/gles3test ES31 >M8R4:results/4-sdl2-gles3test-release.txt
  Echo "step 4 done" >>M8R4:results/00-progress.txt
EndIf
If NOT {FROM} GT 5 VAL
  Echo "Step 5 of 5: the same with SDL3, a second."
  M8R4:bin3/gles3test ES31 >M8R4:results/5-sdl3-gles3test-release.txt
  Echo "step 5 done" >>M8R4:results/00-progress.txt
EndIf
Avail FLUSH >NIL:
Assign LIBS: M8R4:libs-release REMOVE

CD M8R4:
UnSetEnv OGLES3/LogFile
Assign OGLES3Cache:
If NOT EXISTS M8R4:results/notes.txt
  Copy M8R4:notes-template.txt M8R4:results/notes.txt
EndIf
List M8R4:results >M8R4:results/99-files.txt
Echo "finished" >>M8R4:results/00-progress.txt
Date >>M8R4:results/00-progress.txt
Assign M8R4:
Echo ""
Echo "Done. Results are in results/."
