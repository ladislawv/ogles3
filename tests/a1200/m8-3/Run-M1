; Run-M1 - ogles2 M8 run 3: dEQP-GLES31 conformance tests. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   A group of the must-pass list (caselists/<LIST>.txt):
;                                  Execute Run-M1 LIST=fbo
;   Tests by dEQP pattern:         Execute Run-M1 CASES=dEQP-GLES31.functional.fbo.*
;   The result files' name:        Execute Run-M1 LIST=fbo NAME=fbo-2
;   With 4x multisampling:         Execute Run-M1 MSAA=1
;   Result images in the log:      Execute Run-M1 CASES=... IMAGES=1
;   Shader sources in the log:     Execute Run-M1 CASES=... SOURCES=1
;   Watched from the PC:           Execute Run-M1 CASES=... PROGRESS=1
;     (tools/amictl/deqp_watch.py: each case's start and end in
;     RAM:deqp-progress.txt, the library's log in RAM:ogles2.log, both read
;     as they grow and copied into results/ at the end)
; Nothing is installed. Output goes to results/: <NAME>.txt (what dEQP
; prints, with the totals at the end) and <NAME>.qpa (its full log); NAME
; is LIST's, else "deqp".
.key CASES/K,LIST/K,NAME/K,MSAA/K,IMAGES/K,PROGRESS/K,SOURCES/K
.def CASES dEQP-GLES31.info.*
.def LIST ""
.def NAME ""
.def MSAA 0
.def IMAGES 0
.def PROGRESS 0
.def SOURCES 0
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles3.library
  Echo "Please CD into the ogles2-m8-3 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M8R3: ""
If NOT EXISTS M8R3:results
  MakeDir M8R3:results
EndIf
If NOT EXISTS M8R3:cache
  MakeDir M8R3:cache
EndIf

; Which tests, and the result files' name. Not in quotes: there "*"
; escapes the next character.
Set DEQPSEL --deqp-case={CASES}
Set DEQPNAME deqp
If NOT "{LIST}" EQ ""
  If NOT EXISTS M8R3:caselists/{LIST}.txt
    Echo "No list caselists/{LIST}.txt (see that directory)."
    Quit 20
  EndIf
  Set DEQPSEL --deqp-caselist-file=M8R3:caselists/{LIST}.txt
  Set DEQPNAME {LIST}
EndIf
If NOT "{NAME}" EQ ""
  Set DEQPNAME {NAME}
EndIf
Set DEQPIMG disable
If {IMAGES} EQ 1 VAL
  Set DEQPIMG enable
EndIf
Set DEQPSRC disable
If {SOURCES} EQ 1 VAL
  Set DEQPSRC enable
EndIf
Set DEQPCFG rgba8888d24s8ms0
If {MSAA} EQ 1 VAL
  Set DEQPCFG rgba8888d24s8ms4
EndIf

Echo ogles2 M8 run 3: $DEQPSEL >>M8R3:results/00-progress.txt
Date >>M8R3:results/00-progress.txt
Assign LIBS: M8R3:libs ADD
Assign OGLES3Cache: M8R3:cache
Avail FLUSH >NIL:
SetEnv OGLES3/LogFile M8R3:results/ogles2.log
If {PROGRESS} EQ 1 VAL
  Delete RAM:deqp-progress.txt RAM:ogles2.log QUIET >NIL:
  Echo "R $DEQPNAME" >RAM:deqp-progress.txt
  SetEnv DEQP_PROGRESS RAM:deqp-progress.txt
  SetEnv OGLES3/LogFile RAM:ogles2.log
EndIf
; C++ with exceptions and deep test code: more stack than the Shell's.
Stack 1048576
; dEQP reads its data from gles31/ in --deqp-archive-dir (its default, ".",
; makes paths "./gles31/...", which AmigaDOS does not know).
CD M8R3:bin

Echo dEQP-GLES31: $DEQPSEL
Echo "  A 256x256 window on the Workbench screen, a test after another; each"
Echo "  test's shaders are compiled on the Amiga the first time (a pause; kept"
Echo "  in cache/). Ctrl-C stops it after the current test."
M8R3:bin/deqp-gles31 $DEQPSEL --deqp-archive-dir=M8R3:bin --deqp-log-filename=M8R3:results/$DEQPNAME.qpa --deqp-log-images=$DEQPIMG --deqp-log-shader-sources=$DEQPSRC --deqp-surface-width=256 --deqp-surface-height=256 --deqp-gl-config-name=$DEQPCFG >M8R3:results/$DEQPNAME.txt
Echo "$DEQPNAME done" >>M8R3:results/00-progress.txt
If {PROGRESS} EQ 1 VAL
  Copy RAM:deqp-progress.txt M8R3:results/ QUIET
  Copy RAM:ogles2.log M8R3:results/ QUIET
  UnSetEnv DEQP_PROGRESS
EndIf
UnSet DEQPSEL
UnSet DEQPNAME
UnSet DEQPCFG
UnSet DEQPIMG
UnSet DEQPSRC

CD M8R3:
UnSetEnv OGLES3/LogFile
Assign OGLES3Cache:
Assign LIBS: M8R3:libs REMOVE
If NOT EXISTS M8R3:results/notes.txt
  Copy M8R3:notes-template.txt M8R3:results/notes.txt
EndIf
List M8R3:results >M8R3:results/99-files.txt
Echo "finished" >>M8R3:results/00-progress.txt
Date >>M8R3:results/00-progress.txt
Assign M8R3:
Echo ""
Echo "Done. Results are in results/."
