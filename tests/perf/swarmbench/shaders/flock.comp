#version 310 es
// Boing Swarm, step 1: flocking through the neighbour grid (stay apart,
// match speed, keep together) over the 27 cells round each boid, at most
// u_max neighbours looked at, with the pull to its place on the ball. A
// u_every-th of the boids look a frame (whole work groups in turn), with
// u_every times the steer. Each boid is then counted into the cell it
// moved to, for the next frame's grid (scan.comp, scatter.comp).
layout(local_size_x = 128) in;
struct Boid { vec4 pos; vec4 vel; };
layout(std430, binding = 0) readonly buffer Src { Boid b[]; } src;
layout(std430, binding = 1) writeonly buffer Dst { Boid b[]; } dst;
layout(std430, binding = 2) buffer Counts { uint c[]; } counts;
layout(std430, binding = 3) readonly buffer Starts { uint s[]; } starts;
layout(std430, binding = 4) writeonly buffer Cells { uvec2 cr[]; } cells;
layout(std430, binding = 5) readonly buffer Sorted { uint i[]; } sorted;
layout(rgba32f, binding = 0) writeonly uniform highp image2D u_img;
uniform int u_n;
uniform int u_max;
uniform int u_frame;
uniform int u_every;
uniform float u_dt;
uniform float u_spin;
uniform vec3 u_centre;

vec4 home(int i)
{
    float y = 1.0 - 2.0 * (float(i) + 0.5) / float(u_n);
    float r = sqrt(max(1.0 - y * y, 0.0));
    float phi = mod(float(i) * 2.3999632, 6.2831853);
    float lon = mod(phi + u_spin, 6.2831853);
    float check = mod(floor(phi * 2.5464791) + floor((y + 1.0) * 4.0), 2.0);
    vec3 p = vec3(cos(lon) * r, y, sin(lon) * r) * 3.0;
    float c = 0.9553365, s = 0.2955202; // the 1984 ball's tilt, 0.3 rad
    return vec4(u_centre + vec3(c * p.x - s * p.y, s * p.x + c * p.y, p.z), check);
}

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= u_n)
        return;
    vec3 p = src.b[i].pos.xyz, v = src.b[i].vel.xyz;
    vec4 h = home(i);
    vec3 a = (h.xyz - p) * 9.0 - v * 4.0;
    if ((i >> 7) % u_every == u_frame % u_every) { // by work group: the GPU runs 16 boids side by side
        vec3 sep = vec3(0.0), avel = vec3(0.0), apos = vec3(0.0);
        float seen = 0.0;
        int looked = 0;
        ivec3 g = clamp(ivec3((p + 4.0) * 2.0), 1, 14);
        for (int dz = -1; dz <= 1 && looked < u_max; dz++)
            for (int dy = -1; dy <= 1 && looked < u_max; dy++)
                for (int dx = -1; dx <= 1 && looked < u_max; dx++) {
                    uint c = uint(g.x + dx + 16 * (g.y + dy + 16 * (g.z + dz)));
                    uint k = starts.s[c], e = starts.s[c + 1u];
                    for (; k < e && looked < u_max; k++, looked++) {
                        uint j = sorted.i[k];
                        vec3 d = src.b[j].pos.xyz - p;
                        float d2 = dot(d, d);
                        if (j == uint(i) || d2 > 0.25)
                            continue;
                        sep -= d / (d2 + 0.01);
                        avel += src.b[j].vel.xyz;
                        apos += d;
                        seen += 1.0;
                    }
                }
        if (seen > 0.0)
            a += (sep * 0.02 + (avel / seen - v) * 0.5 + apos / seen * 0.5) * float(u_every);
    }
    v += a * u_dt;
    p += v * u_dt;
    dst.b[i].pos = vec4(p, h.w);
    dst.b[i].vel = vec4(v, 0.0);
    imageStore(u_img, ivec2(i & 127, i >> 7), vec4(p, h.w));
    ivec3 g = clamp(ivec3((p + 4.0) * 2.0), 0, 15);
    uint c = uint(g.x + 16 * (g.y + 16 * g.z));
    cells.cr[i] = uvec2(c, atomicAdd(counts.c[c], 1u));
}
