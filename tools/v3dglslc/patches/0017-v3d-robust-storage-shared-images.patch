+/* ogles2 (PiStorm): the V3D's MMU is unused, so a store outside its buffer
+ * would land in the Amiga's memory. A stage with storage buffers or shared
+ * variables keeps its accesses inside them (robust_storage_access, shared
+ * memory included: vir.c's should_lower_robustness), one with images
+ * inside its images; other keys stay as they were. docs/GLES3_PLAN.md
+ * stage D item 2. */
+static void
+v3d_setup_robust_key(struct v3d_key *key, const struct v3d_uncompiled_shader *so)
+{
+        const nir_shader *s = so ? so->base.ir.nir : NULL;
+
+        if (!s)
+                return;
+        if (s->info.num_ssbos || s->info.shared_size)
+                key->robust_storage_access = true;
+        if (s->info.num_images)
+                key->robust_image_access = true;
+}
+
