#version 310 es
// ES 3.1 atomic counters (m8_draw's test_atomic_counters): Mesa makes them
// storage accesses (FORMAT.md, ATOMIC_BUFFERS).
layout(local_size_x = 16) in;
layout(binding = 2, offset = 4) uniform atomic_uint count;
layout(std430, binding = 0) writeonly buffer Out { uint dst[]; };
void main()
{
    dst[gl_GlobalInvocationID.x] = atomicCounterIncrement(count);
}
