#version 310 es
// The neighbour grid, 2 of 2: each boid's index at its place in the sorted
// list, so a cell's boids lie together.
layout(local_size_x = 128) in;
layout(std430, binding = 3) readonly buffer Starts { uint s[]; } starts;
layout(std430, binding = 4) readonly buffer Cells { uvec2 cr[]; } cells;
layout(std430, binding = 5) writeonly buffer Sorted { uint i[]; } sorted;
uniform int u_n;

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    if (i >= u_n)
        return;
    uvec2 cr = cells.cr[i];
    sorted.i[starts.s[cr.x] + cr.y] = uint(i);
}
