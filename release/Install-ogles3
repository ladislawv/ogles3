; Install-ogles3 - installs ogles3.library 1.0 (release 1.0-beta2). See ReadMe.
; From a Shell, in this drawer:   Execute Install-ogles3
; It asks before each step; with ALL it does every step without asking:
;                                 Execute Install-ogles3 ALL
.key ALL/S
.bra {
.ket }

FailAt 21
If NOT EXISTS Libs/ogles3.library
  Echo "Please CD into the drawer of this archive first, then:"
  Echo "  Execute Install-ogles3"
  Quit 20
EndIf

Echo "ogles3.library 1.0 (release 1.0-beta2): OpenGL ES 3.1 for PiStorm (Raspberry Pi 4)"
Echo "It goes beside ogles2.library 1.x, which stays as it is."
Echo ""

; ---- the library
If "{ALL}" EQ ""
  Ask "Copy ogles3.library to LIBS:? (y/n)"
  If NOT WARN
    Skip compiler
  EndIf
EndIf
; Copy answers 0 even when it copied nothing (a full disk, a protected
; file), so each copy is checked with Version, which answers 5 for an older
; version and 20 for none. The numbers are this library's (build_release.sh
; checks them). An installed one is deleted first: 1.0-beta1's is version
; 1.0 too, and Version would take it for this one if the copy failed.
Delete >NIL: LIBS:ogles3.library FORCE QUIET
Copy Libs/ogles3.library LIBS: CLONE
Version >NIL: LIBS:ogles3.library 1 0 FILE
If WARN
  Echo "Could not copy ogles3.library to LIBS:."
  Quit 20
EndIf
; an older version still in memory is replaced at its next opening
Avail FLUSH >NIL:
Echo "  LIBS:ogles3.library installed."
; An installed compiler is replaced with this release's, whatever its
; version: the library and the compiler are a pair (1.0-beta1's v3dglslc3,
; also version 1.0, served another port and never answers this library).
; The library uses LIBS:v3dglslc3 first (ogles2.library 1.x's LIBS:v3dglslc
; is another program, left as it is).
If EXISTS LIBS:v3dglslc3
  Delete >NIL: LIBS:v3dglslc3 FORCE QUIET
  Copy Libs/v3dglslc3 LIBS: CLONE
  Version >NIL: LIBS:v3dglslc3 1 0 FILE
  If WARN
    Echo "Could not replace LIBS:v3dglslc3 (19 MB free? write-protected?)."
    Quit 20
  EndIf
  Echo "  LIBS:v3dglslc3 replaced with this release's."
  Skip cache
EndIf

; ---- the shader compiler
Lab compiler
Echo ""
Echo "The shader compiler v3dglslc3 (19 MB) compiles programs' shaders the"
Echo "first time they run. Programs that ship their compiled shaders (such"
Echo "as the examples) do not need it; programs that make shaders at run"
Echo "time (gl4es, for instance) do."
If "{ALL}" EQ ""
  Ask "Copy v3dglslc3 to LIBS:? (y/n)"
  If NOT WARN
    Skip cache
  EndIf
EndIf
Copy Libs/v3dglslc3 LIBS: CLONE
Version >NIL: LIBS:v3dglslc3 1 0 FILE
If WARN
  Echo "Could not copy v3dglslc3 to LIBS: (19 MB free? write-protected?)."
  Quit 20
EndIf
Echo "  LIBS:v3dglslc3 installed."

; ---- the cache of compiled shaders
Lab cache
Echo ""
Echo "Compiled shaders can be kept across reboots in SYS:OGLES3Cache, with"
Echo "the assign OGLES3Cache: made in S:User-Startup. Without it they are"
Echo "kept in T: until the next reboot."
If "{ALL}" EQ ""
  Ask "Make SYS:OGLES3Cache and the assign? (y/n)"
  If NOT WARN
    Skip log
  EndIf
EndIf
If NOT EXISTS SYS:OGLES3Cache
  MakeDir SYS:OGLES3Cache
  If ERROR
    Echo "Could not make SYS:OGLES3Cache."
    Quit 20
  EndIf
EndIf
Assign OGLES3Cache: SYS:OGLES3Cache
If EXISTS S:User-Startup
  Search S:User-Startup "OGLES3Cache:" QUIET >NIL:
  If WARN
    Echo ";BEGIN ogles3" >>S:User-Startup
    Echo "Assign OGLES3Cache: SYS:OGLES3Cache" >>S:User-Startup
    Echo ";END ogles3" >>S:User-Startup
    Echo "  Added to S:User-Startup."
  Else
    Echo "  S:User-Startup already assigns OGLES3Cache:."
  EndIf
Else
  Echo ";BEGIN ogles3" >S:User-Startup
  Echo "Assign OGLES3Cache: SYS:OGLES3Cache" >>S:User-Startup
  Echo ";END ogles3" >>S:User-Startup
  Echo "  S:User-Startup made."
EndIf

; ---- OGLES3Log
Lab log
Echo ""
If "{ALL}" EQ ""
  Ask "Copy OGLES3Log (writes the library's log) to C:? (y/n)"
  If NOT WARN
    Skip done
  EndIf
EndIf
Copy C/OGLES3Log C: CLONE
If ERROR
  Echo "Could not copy OGLES3Log to C:."
  Quit 20
EndIf
Echo "  C:OGLES3Log installed."

Lab done
Echo ""
Echo "Done. Try Examples/triangle and Examples/cube."
