+#ifdef DEQP_C3_KERNEL
+// On the ARM cores (ports/deqp/c3): the case's statement rebuilt as
+// FuncCase/InOutFuncCase::runTest() build it, then testStatement()'s loop
+// over job.first..first+count without the log: job.status[i] = 1 for a value
+// outside its expected range (a failure or a quality warning there), 0 else.
+// The number flagged, or -1 when this side cannot (the m68k does them all).
+
+// addBuiltinPrecisionTests()'s formats
+FloatFormat c3Format(int precision)
+{
+    switch (precision)
+    {
+    case glu::PRECISION_LOWP:
+        return FloatFormat(0, 0, 7, false, tcu::YES);
+    case glu::PRECISION_MEDIUMP:
+        return FloatFormat(-13, 13, 9, false);
+    default:
+        return FloatFormat(-126, 127, 23, true, tcu::MAYBE, tcu::YES, tcu::MAYBE);
+    }
+}
+
+// testStatement()'s loop over values [first, first + count), without the log.
+// pick >= 0 (the self-test): each output set from its reference interval
+// first (0 its midpoint, 1 its low end, 2 its high end), *hash then takes
+// the outputs' 32-bit words (the same on both byte orders).
+template <typename T>
+struct C3Pick;
+
+template <>
+struct C3Pick<float>
+{
+    static float get(const Interval &i, int pick)
+    {
+        const double d = i.empty() ? 0.0 : pick == 0 ? i.midpoint() : pick == 1 ? i.lo() : i.hi();
+        return d != d ? 0.0f : float(d); // NaN
+    }
+};
+
+template <>
+struct C3Pick<int>
+{
+    static int get(const Interval &i, int pick)
+    {
+        const double d = C3Pick<float>::get(i, pick);
+        return (d > -2147483648.0 && d < 2147483647.0) ? int(d) : 0;
+    }
+};
+
+template <>
+struct C3Pick<bool>
+{
+    static bool get(const Interval &i, int pick)
+    {
+        return C3Pick<float>::get(i, pick) != 0.0f;
+    }
+};
+
+template <>
+struct C3Pick<Void>
+{
+    static Void get(const Void &, int)
+    {
+        return Void();
+    }
+};
+
+template <typename T, int Size>
+struct C3Pick<Vector<T, Size>>
+{
+    template <typename IV>
+    static Vector<T, Size> get(const IV &iv, int pick)
+    {
+        Vector<T, Size> r;
+        for (int i = 0; i < Size; i++)
+            r[i] = C3Pick<T>::get(iv[i], pick);
+        return r;
+    }
+};
+
+template <typename T, int Rows, int Cols>
+struct C3Pick<Matrix<T, Rows, Cols>>
+{
+    template <typename IV>
+    static Matrix<T, Rows, Cols> get(const IV &iv, int pick)
+    {
+        Matrix<T, Rows, Cols> r;
+        for (int row = 0; row < Rows; row++)
+            for (int col = 0; col < Cols; col++)
+                r(row, col) = C3Pick<T>::get(iv(row, col), pick);
+        return r;
+    }
+};
+
+template <typename T>
+void c3Hash(uint32_t &hash, const T &value)
+{
+    if (sizeof(T) % 4 != 0)
+        return; // Void
+    for (size_t i = 0; i < sizeof(T); i += 4)
+    {
+        uint32_t w;
+        deMemcpy(&w, (const char *)&value + i, 4);
+        if (w == 0x80000000u)
+            w = 0; // -0 as 0: the sign of a zero (rounding modes) never decides a check
+        hash = (hash ^ w) * 16777619u;
+    }
+}
+
+template <typename In, typename Out>
+int c3CheckRange(const Variables<In, Out> &variables, const Statement &stmt, Precision precision,
+                 const typename In::In0 *in0, const typename In::In1 *in1, const typename In::In2 *in2,
+                 const typename In::In3 *in3, typename Out::Out0 *out0, typename Out::Out1 *out1, uint8_t *status,
+                 size_t first, size_t count, int pick, uint32_t *hash)
+{
+    typedef typename In::In0 In0;
+    typedef typename In::In1 In1;
+    typedef typename In::In2 In2;
+    typedef typename In::In3 In3;
+    typedef typename Out::Out0 Out0;
+    typedef typename Out::Out1 Out1;
+
+    const FloatFormat fmt      = c3Format(precision);
+    const FloatFormat highpFmt = c3Format(glu::PRECISION_HIGHP);
+    const int inCount          = numInputs<In>();
+    const int outCount         = numOutputs<Out>();
+    const In0 none0            = In0();
+    const In1 none1            = In1();
+    const In2 none2            = In2();
+    const In3 none3            = In3();
+    Environment env;
+    int flagged = 0;
+
+    {
+        const typename Traits<In0>::IVal i0;
+        const typename Traits<In1>::IVal i1;
+        const typename Traits<In2>::IVal i2;
+        const typename Traits<In3>::IVal i3;
+        const typename Traits<Out0>::IVal r0;
+        const typename Traits<Out1>::IVal r1;
+
+        env.bind(*variables.in0, i0);
+        env.bind(*variables.in1, i1);
+        env.bind(*variables.in2, i2);
+        env.bind(*variables.in3, i3);
+        env.bind(*variables.out0, r0);
+        env.bind(*variables.out1, r1);
+    }
+
+    for (size_t valueNdx = first; valueNdx < first + count; valueNdx++)
+    {
+        bool result = true;
+
+        env.lookup(*variables.in0) = convert<In0>(fmt, round(fmt, inCount > 0 ? in0[valueNdx] : none0));
+        env.lookup(*variables.in1) = convert<In1>(fmt, round(fmt, inCount > 1 ? in1[valueNdx] : none1));
+        env.lookup(*variables.in2) = convert<In2>(fmt, round(fmt, inCount > 2 ? in2[valueNdx] : none2));
+        env.lookup(*variables.in3) = convert<In3>(fmt, round(fmt, inCount > 3 ? in3[valueNdx] : none3));
+
+        {
+            EvalContext ctx(fmt, precision, env);
+            stmt.execute(ctx);
+        }
+
+        if (outCount > 1)
+        {
+            const typename Traits<Out1>::IVal reference1 = convert<Out1>(highpFmt, env.lookup(*variables.out1));
+            if (pick >= 0)
+            {
+                out1[valueNdx] = C3Pick<Out1>::get(reference1, pick);
+                c3Hash(*hash, out1[valueNdx]);
+            }
+            if (!contains(reference1, out1[valueNdx]))
+                result = false;
+        }
+        if (outCount > 0)
+        {
+            const typename Traits<Out0>::IVal reference0 = convert<Out0>(highpFmt, env.lookup(*variables.out0));
+            if (pick >= 0)
+            {
+                out0[valueNdx] = C3Pick<Out0>::get(reference0, pick);
+                c3Hash(*hash, out0[valueNdx]);
+            }
+            if (!contains(reference0, out0[valueNdx]))
+                result = false;
+        }
+
+        status[valueNdx] = result ? 0 : 1;
+        if (!result)
+            ++flagged;
+    }
+
+    return flagged;
+}
+
+// deqp_c3_check's: the m68k's values, after the checks that both sides
+// agree on the case (the format, the values' sizes)
+template <typename In, typename Out>
+int c3CheckValues(const Variables<In, Out> &variables, const Statement &stmt, DeqpC3PrecJob &job)
+{
+    typedef typename In::In0 In0;
+    typedef typename In::In1 In1;
+    typedef typename In::In2 In2;
+    typedef typename In::In3 In3;
+    typedef typename Out::Out0 Out0;
+    typedef typename Out::Out1 Out1;
+
+    const Precision precision = Precision(job.precision);
+    const FloatFormat fmt     = c3Format(precision);
+    const int inCount         = numInputs<In>();
+    const int outCount        = numOutputs<Out>();
+
+    if (job.fmt[0] != (uint32_t)fmt.getMinExp() || job.fmt[1] != (uint32_t)fmt.getMaxExp() ||
+        job.fmt[2] != (uint32_t)fmt.getFractionBits() || job.fmt[3] != (uint32_t)fmt.hasSubnormal() ||
+        job.fmt[4] != (uint32_t)fmt.hasInf())
+        return -1;
+    if (inCount < 1 || job.inSize[0] != sizeof(In0) || (inCount > 1 && job.inSize[1] != sizeof(In1)) ||
+        (inCount > 2 && job.inSize[2] != sizeof(In2)) || (inCount > 3 && job.inSize[3] != sizeof(In3)) ||
+        (outCount > 0 && job.outSize[0] != sizeof(Out0)) || (outCount > 1 && job.outSize[1] != sizeof(Out1)) ||
+        job.first + job.count > job.numValues)
+        return -1;
+
+    return c3CheckRange(variables, stmt, precision, C3_PTR(const In0, job.in[0]), C3_PTR(const In1, job.in[1]),
+                        C3_PTR(const In2, job.in[2]), C3_PTR(const In3, job.in[3]), C3_PTR(Out0, job.out[0]),
+                        C3_PTR(Out1, job.out[1]), C3_PTR(uint8_t, job.status), job.first, job.count, -1, nullptr);
+}
+
+// The self-test's (job.version DEQP_C3_SELFTEST, ports/deqp/c3/selftest):
+// numValues of the case's own inputs (a fixed seed), outputs from their
+// reference (job.first: which end), the check of them. job.result: the
+// number flagged, job.status: the outputs' hash.
+template <typename In, typename Out>
+int c3SelfTestValues(const Variables<In, Out> &variables, const Statement &stmt, DeqpC3PrecJob &job)
+{
+    const Precision precision = Precision(job.precision);
+    Random rnd(0xdeadbeefu);
+    const Inputs<In> inputs(
+        generateInputs(instance<DefaultSamplings<In>>(), c3Format(precision), precision, job.numValues, rnd));
+    const size_t numValues = inputs.in0.size();
+    Outputs<Out> outputs(numValues);
+    vector<uint8_t> status(numValues);
+    uint32_t hash = 2166136261u;
+
+    if (numValues == 0)
+        return 0;
+    const int flagged =
+        c3CheckRange(variables, stmt, precision, &inputs.in0.front(),
+                     numInputs<In>() > 1 ? &inputs.in1.front() : nullptr,
+                     numInputs<In>() > 2 ? &inputs.in2.front() : nullptr,
+                     numInputs<In>() > 3 ? &inputs.in3.front() : nullptr, &outputs.out0.front(),
+                     numOutputs<Out>() > 1 ? &outputs.out1.front() : nullptr, &status.front(), 0, numValues,
+                     int(job.first & 3), &hash);
+    if (job.first & 0x100) // pick + 256: every value's inputs and outputs, as 32-bit words
+        for (size_t i = 0; i < numValues; i++)
+        {
+            uint32_t w[4] = {0, 0, 0, 0};
+            deMemcpy(w, &inputs.in0[i], de::min(sizeof(inputs.in0[i]), sizeof(w)));
+            printf("  %u: in0 %08x %08x %08x %08x", (unsigned)i, w[0], w[1], w[2], w[3]);
+            if (numInputs<In>() > 1)
+            {
+                deMemset(w, 0, sizeof(w));
+                deMemcpy(w, &inputs.in1[i], de::min(sizeof(inputs.in1[i]), sizeof(w)));
+                printf(" in1 %08x %08x %08x %08x", w[0], w[1], w[2], w[3]);
+            }
+            deMemset(w, 0, sizeof(w));
+            deMemcpy(w, &outputs.out0[i], de::min(sizeof(outputs.out0[i]), sizeof(w)));
+            printf(" out0 %08x %08x %08x %08x\n", w[0], w[1], w[2], w[3]);
+        }
+    job.status = hash;
+    job.count  = (uint32_t)numValues;
+    return flagged;
+}
+
+template <typename In, typename Out>
+int c3Values(const Variables<In, Out> &variables, const Statement &stmt, DeqpC3PrecJob &job)
+{
+    return job.version == DEQP_C3_SELFTEST ? c3SelfTestValues(variables, stmt, job) :
+                                             c3CheckValues(variables, stmt, job);
+}
+
+template <typename Sig>
+int c3CheckFunc(const Func<Sig> &func, DeqpC3PrecJob &job)
+{
+    typedef typename Sig::Ret Ret;
+    typedef typename Sig::Arg0 Arg0;
+    typedef typename Sig::Arg1 Arg1;
+    typedef typename Sig::Arg2 Arg2;
+    typedef typename Sig::Arg3 Arg3;
+
+    switch (func.getOutParamIndex())
+    {
+    case -1: // FuncCase
+    {
+        typedef InTypes<Arg0, Arg1, Arg2, Arg3> In;
+        typedef OutTypes<Ret> Out;
+        Variables<In, Out> variables;
+
+        variables.out0 = variable<Ret>("out0");
+        variables.out1 = variable<Void>("out1");
+        variables.in0  = variable<Arg0>("in0");
+        variables.in1  = variable<Arg1>("in1");
+        variables.in2  = variable<Arg2>("in2");
+        variables.in3  = variable<Arg3>("in3");
+
+        ExprP<Ret> expr = applyVar(func, variables.in0, variables.in1, variables.in2, variables.in3);
+        StatementP stmt = variableAssignment(variables.out0, expr);
+
+        return c3Values(variables, *stmt, job);
+    }
+    case 1: // InOutFuncCase
+    {
+        typedef InTypes<Arg0, Arg2, Arg3> In;
+        typedef OutTypes<Ret, Arg1> Out;
+        Variables<In, Out> variables;
+
+        variables.out0 = variable<Ret>("out0");
+        variables.out1 = variable<Arg1>("out1");
+        variables.in0  = variable<Arg0>("in0");
+        variables.in1  = variable<Arg2>("in1");
+        variables.in2  = variable<Arg3>("in2");
+        variables.in3  = variable<Void>("in3");
+
+        ExprP<Ret> expr = applyVar(func, variables.in0, variables.out1, variables.in1, variables.in2);
+        StatementP stmt = variableAssignment(variables.out0, expr);
+
+        return c3Values(variables, *stmt, job);
+    }
+    default:
+        return -1;
+    }
+}
+#endif
