+#ifdef DEQP_C3_KERNEL
+// The kernels (core3.library, C3_FindSymbol). deqp_c3_setup(DeqpC3Setup *):
+// the heap and the functions, once per module loaded; deqp_c3_check
+// (DeqpC3PrecJob *): a case's values job.first.. on that module's heap;
+// deqp_c3_selftest (DeqpC3SelfTest *): c3SelfTest().
+// Each returns 1, or 2 when it cannot (the m68k then does it all).
+extern "C" C3_EXPORT uint32_t deqp_c3_setup(uint32_t arg, const C3Services *svc)
+{
+    using namespace deqp::gls::BuiltinPrecisionTests;
+    DeqpC3Setup *const setup = C3_PTR(DeqpC3Setup, arg);
+
+    if (setup->version != DEQP_C3_VERSION)
+        return 2;
+    c3cxx::init(svc, C3_PTR(void, setup->heap), setup->heapSize);
+    c3Cases[0] = createES3BuiltinCases().release();
+    c3Cases[1] = createES31BuiltinCases().release();
+    return 1;
+}
+
+extern "C" C3_EXPORT uint32_t deqp_c3_selftest(uint32_t arg, const C3Services *svc)
+{
+    using namespace deqp::gls::BuiltinPrecisionTests;
+    DeqpC3SelfTest *const test = C3_PTR(DeqpC3SelfTest, arg);
+
+    c3cxx::set_services(svc);
+    if (test->version != DEQP_C3_VERSION || !c3Cases[0])
+        return 2;
+    c3SelfTest(*test);
+    return 1;
+}
+
+extern "C" C3_EXPORT uint32_t deqp_c3_check(uint32_t arg, const C3Services *svc)
+{
+    using namespace deqp::gls::BuiltinPrecisionTests;
+    DeqpC3PrecJob *const job = C3_PTR(DeqpC3PrecJob, arg);
+
+    c3cxx::set_services(svc);
+    if (job->version != DEQP_C3_VERSION || !c3Cases[0])
+        return 2;
+    const CaseFactory *const factory = c3Factory(C3_PTR(const char, job->factory));
+    if (!factory)
+        return 2;
+    const int flagged = factory->c3Check(C3_PTR(const char, job->sub), *job);
+    if (flagged < 0)
+        return 2;
+    job->result = (uint32_t)flagged;
+    return 1;
+}
+#endif
