+#ifdef DEQP_C3_KERNEL
+// The ES 3 and ES 3.1 functions, made once by deqp_c3_setup (no static
+// objects with constructors on the ARM cores).
+const CaseFactories *c3Cases[2];
+
+const CaseFactory *c3Factory(const char *name)
+{
+    for (int set = 0; set < 2; set++)
+    {
+        if (!c3Cases[set])
+            continue;
+        const vector<const CaseFactory *> factories = c3Cases[set]->getFactories();
+        for (size_t ndx = 0; ndx < factories.size(); ++ndx)
+            if (factories[ndx]->getName() == name)
+                return factories[ndx];
+    }
+    return nullptr;
+}
+
+// The self-test (ports/deqp/c3/selftest): every function's cases at every
+// precision, test.numValues of their inputs each, the outputs from their
+// reference intervals (test.pick); a line per case (printf: C3Log on the ARM
+// cores, stdout on the PC), the totals in test.
+bool c3SelfTestCase(DeqpC3SelfTest &test, const CaseFactory &factory, const string &sub, int precision)
+{
+    DeqpC3PrecJob job;
+    deMemset(&job, 0, sizeof(job));
+    job.version   = DEQP_C3_SELFTEST;
+    job.precision = (uint32_t)precision;
+    job.numValues = test.numValues;
+    job.first     = test.pick;
+    const int r   = factory.c3Check(sub, job);
+    if (r < 0)
+        return false;
+    printf("selftest %s %s %s: %d of %u flagged, hash %08x\n", factory.getName().c_str(), sub.c_str(),
+           glu::getPrecisionName(Precision(precision)), r, (unsigned)job.count, (unsigned)job.status);
+    test.cases++;
+    test.flagged += (uint32_t)r;
+    test.hash = (test.hash ^ job.status) * 16777619u;
+    return true;
+}
+
+void c3SelfTest(DeqpC3SelfTest &test)
+{
+    const string subs[] = {"scalar",
+                           "vec2",
+                           "vec3",
+                           "vec4",
+                           dataTypeNameOf<Matrix<float, 2, 2>>(),
+                           dataTypeNameOf<Matrix<float, 3, 2>>(),
+                           dataTypeNameOf<Matrix<float, 4, 2>>(),
+                           dataTypeNameOf<Matrix<float, 2, 3>>(),
+                           dataTypeNameOf<Matrix<float, 3, 3>>(),
+                           dataTypeNameOf<Matrix<float, 4, 3>>(),
+                           dataTypeNameOf<Matrix<float, 2, 4>>(),
+                           dataTypeNameOf<Matrix<float, 3, 4>>(),
+                           dataTypeNameOf<Matrix<float, 4, 4>>()};
+
+    test.cases   = 0;
+    test.flagged = 0;
+    test.hash    = 2166136261u;
+    for (int set = 0; set < 2; set++)
+    {
+        if (!c3Cases[set])
+            continue;
+        const vector<const CaseFactory *> factories = c3Cases[set]->getFactories();
+        for (size_t ndx = 0; ndx < factories.size(); ++ndx)
+            for (int precision = 0; precision < glu::PRECISION_LAST; precision++)
+            {
+                // a SimpleFuncCaseFactory's one case takes any name
+                if (c3SelfTestCase(test, *factories[ndx], "-", precision))
+                    continue;
+                for (size_t i = 0; i < DE_LENGTH_OF_ARRAY(subs); i++)
+                    c3SelfTestCase(test, *factories[ndx], subs[i], precision);
+            }
+    }
+}
+#endif
